# Copy to .env and fill in. Never commit .env.

# --- chain selection -------------------------------------------------------
# testnet4 while developing; switch to: BITCOIN_CHAIN=main, POOL_NETWORK=mainnet,
# BITCOIN_RPC_PORT=8332 for go-live (M4).
BITCOIN_CHAIN=testnet4
POOL_NETWORK=testnet
BITCOIN_RPC_PORT=48332

# --- bitcoind RPC (used by bitcoind AND miner) -------------------
BITCOIN_RPC_USER=prometejs
BITCOIN_RPC_PASSWORD=CHANGE_ME_long_random_string

# RAM for Core's db cache during initial sync (MB)
BITCOIN_DBCACHE=2000

# --- monitoring ------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Optional OpenTelemetry traces + metrics (OTLP/HTTP protobuf, usually port 4318).
# Leave endpoints unset to disable export. Set these in the process environment.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=prometejs-miner
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=production
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20your-token
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
# OTEL_METRIC_EXPORT_INTERVAL=60000
# OTEL_SDK_DISABLED=true
